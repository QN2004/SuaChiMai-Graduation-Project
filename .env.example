# Dify Configuration
DIFY_API_KEY=

# Backend/Frontend Expose Ports
EXPOSE_BACKEND_PORT=5000
EXPOSE_FRONTEND_PORT=3000

# Nginx Expose Ports (for Dify, if not using Cloudflare Tunnel)
EXPOSE_NGINX_PORT=3080
EXPOSE_NGINX_SSL_PORT=443
# Lô – hạn sử dụng: ngưỡng cận date (% vòng đời lô) và số ngày giao dự kiến
NEAR_EXPIRY_PERCENT=15
DELIVERY_DAYS=7

# Dify Agent: token xác thực giữa agent_backend và local_sandbox (bắt buộc).
# Tạo bằng: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=
