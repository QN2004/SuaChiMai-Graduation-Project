# Dependencies
node_modules/
**/node_modules/

# Environment and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.env.git

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
frontend/dist/
dist/
build/
.vite/

# Uploads generated at runtime (seed assets stay in backend/src/uploads)
/backend/uploads/
/uploads/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary / local backups of git metadata
.git.old-backup/
.git.bak/

# Dify runtime data created on first start
dify/volumes/*
!dify/volumes/sandbox/
dify/volumes/sandbox/*
!dify/volumes/sandbox/conf/
dify/volumes/sandbox/conf/*
!dify/volumes/sandbox/conf/config.yaml
!dify/volumes/sandbox/conf/config.yaml.example
